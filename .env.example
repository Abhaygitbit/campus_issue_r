# Database Configuration (For Production on Render)
# Use PostgreSQL on Render
DB_HOST=your-db-host.c.render.com
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=5432

# Or use SQLite for development
USE_SQLITE=false

# Server Configuration
PORT=8080
RENDER=true
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# JWT Configuration
JWT_SECRET=your-secret-key-change-this

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_VERIFY_ENABLED=false

# Gmail API (optional)
# Download from Google Cloud Console and save as backend/credentials.json
GMAIL_API_ENABLED=false

# App URL (for email links, etc)
APP_URL=https://your-app-name.onrender.com
